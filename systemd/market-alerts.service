[Unit]
Description=USD NAS100 Market Alert Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/market-alerts
EnvironmentFile=/opt/market-alerts/.env
ExecStart=/usr/bin/python3 /opt/market-alerts/app.py
Restart=always
RestartSec=5
User=marketbot

[Install]
WantedBy=multi-user.target
